<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

{% set pluginDirectory = "/usr/local/emhttp/plugins/" ~ name -%}
{% set configDirectory = "/boot/config/plugins/" ~ name -%}
{% set packageFile = package_name ~ "-" ~ env['PLUGIN_VERSION'] ~ "-noarch-1.txz" -%}
{% if env['PLUGIN_RELEASE'] == "-preview" -%}
{% set otherChannel = name -%}
{% else -%}
{% set otherChannel = name ~ "-preview" -%}
{% endif %}

<PLUGIN
  name="{{ name }}{{ env['PLUGIN_RELEASE'] }}"
  author="{{ author }}"
  version="{{ env['PLUGIN_VERSION'] }}"
  launch="{{ launch }}"
  pluginURL="https://raw.githubusercontent.com/{{ env['GITHUB_REPOSITORY'] }}/main/plugin/{{ name }}{{ env['PLUGIN_RELEASE'] }}.plg"
  support="{{ support }}"
  min="{{ min }}"
>

<CHANGES>
<![CDATA[
{{ env['PLUGIN_CHANGELOG'] }}

For older releases, see https://github.com/{{ env['GITHUB_REPOSITORY'] }}/releases
]]>
</CHANGES>

<FILE Name="{{ configDirectory }}/{{ packageFile }}">
<URL>https://github.com/{{ env['GITHUB_REPOSITORY'] }}/releases/download/{{ env['PLUGIN_VERSION'] }}/{{ packageFile }}</URL>
<SHA256>{{ env['PLUGIN_CHECKSUM'] }}</SHA256>
</FILE>

<!--
The 'install' script. Unraid re-installs every /boot/config/plugins/*.plg on
boot, so this runs at boot too: it must be idempotent and must not fail when
Docker or Tailscale are still down.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
if [ -d "{{ pluginDirectory }}" ]; then
    rm -rf {{ pluginDirectory }}
fi

mkdir -p {{ configDirectory }}

# Keep tailnet credentials out of Unraid Connect's flash backup, which is a git
# repo at /boot/.git. Both files' temps are listed, not just the credentials
# one: a save renames a staged file into place, a worker that dies between the
# two leaves that file behind, and the migration stages docktail.cfg from a
# state where it may still hold a credential it is about to move out.
#
# Before upgradepkg, not after: the package's doinst.sh runs the config
# migration, which stages those temps - so the patterns have to be on the flash
# before anything can write one.
printf 'credentials.cfg\ncredentials.cfg.tmp\ncredentials.cfg.tmp.*\ndocktail.cfg.tmp\ndocktail.cfg.tmp.*\n*.unreadable.*\n' > {{ configDirectory }}/.gitignore

# Before upgradepkg, like the ignore file: the package's doinst.sh runs the
# migration, which records what the pair looked like - so the pair has to be
# complete before it looks, or the next boot reports a change that was just
# this install finishing.
#
# noclobber, not a test-then-create: an Apply can land between the two and this
# would then copy /dev/null over credentials it just saved. `set -C` makes the
# redirection itself fail when the file exists, which is one atomic syscall.
(
    umask 077
    set -C
    : > {{ configDirectory }}/credentials.cfg
) 2> /dev/null || true
# Only a real file. chmod follows symlinks and has no option not to, so this
# line - running as root - would otherwise set 0600 on whatever a symlink left
# at that path happened to point at. The umask above already creates the file
# private, so this is for the one it did not create: an existing credentials
# file from a previous install, which the noclobber redirection left alone.
if [ -f {{ configDirectory }}/credentials.cfg ] && [ ! -L {{ configDirectory }}/credentials.cfg ]; then
    chmod 0600 {{ configDirectory }}/credentials.cfg
elif [ -e {{ configDirectory }}/credentials.cfg ] || [ -L {{ configDirectory }}/credentials.cfg ]; then
    echo "docktail: {{ configDirectory }}/credentials.cfg is not a regular file - leaving it as it is. DockTail cannot store credentials there until it is replaced with one."
fi

upgradepkg --install-new {{ configDirectory }}/{{ packageFile }}


# Drop the other release channel so both are never installed at once.
rm -f /boot/config/plugins/{{ otherChannel }}.plg
rm -f /var/log/plugins/{{ otherChannel }}.plg

# Start (or restart) the daemon. Deferred, so a blocking Unraid event returns
# immediately.
{{ pluginDirectory }}/restart.sh

# Clean up superseded packages.
rm -f $(ls {{ configDirectory }}/{{ package_name }}-*.txz 2>/dev/null | grep -v '{{ env['PLUGIN_VERSION'] }}')

echo ""
echo "----------------------------------------------------"
echo " {{ name }}{{ env['PLUGIN_RELEASE'] }} has been installed."
echo " Plugin version:   {{ env['PLUGIN_VERSION'] }}"
echo " DockTail version: {{ docktailVersion }}"
echo ""
echo " Configure it under Settings -> Network Services ->"
echo " DockTail. DockTail needs the Tailscale plugin and a"
echo " tagged Unraid node; the Status tab checks both."
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script. Settings under {{ configDirectory }} are left in place:
Unraid convention is that plugin settings survive removal.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
/usr/local/etc/rc.d/rc.docktail stop 2>/dev/null

removepkg {{ package_name }}

rm -rf {{ pluginDirectory }}
rm -f {{ configDirectory }}/*.txz
]]>
</INLINE>
</FILE>

</PLUGIN>
