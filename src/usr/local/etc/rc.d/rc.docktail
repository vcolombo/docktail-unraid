#!/bin/bash
# /usr/local/etc/rc.d/rc.docktail - start/stop the DockTail daemon
#
# DockTail runs as a native host daemon here, not in a container: it then gets
# an exactly version-matched tailscale CLI/tailscaled pair from the official
# Tailscale plugin, and 127.0.0.1 is the right proxy target for host-networked
# Unraid containers.

PLUGIN_ROOT="/usr/local/emhttp/plugins/docktail"
CONFIG_DIR="/boot/config/plugins/docktail"
BIN="${PLUGIN_ROOT}/bin/docktail"
LOG="/var/log/docktail.log"
PIDFILE="/var/run/docktail.pid"
DOCKER_SOCK="/var/run/docker.sock"
TAILSCALED_SOCK="/var/run/tailscale/tailscaled.sock"
PGREP="/usr/bin/pgrep"
PKILL="/usr/bin/pkill"

# Seconds to wait for a graceful drain before SIGKILL. Must exceed DockTail's
# own 30s shutdown cleanup context: cutting it short leaves stale Tailscale
# Services advertised on the tailnet.
STOP_TIMEOUT=35

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') rc.docktail: $*" >> "$LOG"
}

# These files are data, not code. Sourcing them made bash the parser, which
# meant every character in a stored credential was a potential command: a $ or
# a backtick from an older plugin version, and with a blacklist check, any
# plain command a hand-edited file cared to include. So they are read instead.
#
# Only KEY="value" is recognised - the exact grammar the webGUI writes - and a
# line that is not that is logged and skipped rather than guessed at. Values
# are assigned with declare, which does not re-expand what it is given, so a
# legacy value like x$(id)y arrives as those literal characters.
# Undo exactly what the webGUI's renderBody() escapes - \\, \" and \$ - and
# nothing else, left to right in one pass. Answers in REPLY.
#
# Done character by character rather than with substitutions: parking escaped
# backslashes on a placeholder byte would corrupt any value that legitimately
# contained that byte, and a legacy file can contain anything.
unescape_value() {
  local in="$1" out="" head next

  while [ -n "$in" ]; do
    head="${in:0:1}"

    if [ "$head" = '\' ]; then
      # A backslash with nothing after it cannot have come from
      # renderBody(), and PHP's ini parser would read the rest of the file
      # differently, so the two sides would disagree about the value.
      [ "${#in}" -gt 1 ] || return 1

      next="${in:1:1}"
      case "$next" in
        '\' | '"' | '$')
          out="${out}${next}"
          in="${in:2}"
          continue
          ;;
      esac
    elif [ "$head" = '"' ]; then
      # An unescaped quote inside the value means the closing quote was not
      # where the line said it was - reject rather than guess, because PHP
      # reads such a line differently again.
      return 1
    fi

    out="${out}${head}"
    in="${in:1}"
  done

  REPLY="$out"
  return 0
}

# The only names a config file may set. Without this an uppercase-looking
# assignment in a hand-edited or legacy file would land on one of this
# script's own variables - BIN="/tmp/payload" would then be executed as root
# by start_docktail(), and PGREP the same through is_running(). Mirrored by
# Config::KNOWN_KEYS on the PHP side.
config_key_is_known() {
  case "$1" in
    ENABLE_DOCKTAIL | TAILSCALE_TAILNET | DEFAULT_SERVICE_TAGS | IGNORE_SERVICE_NAMES | \
    DELETE_UNUSED_SERVICES | SKIP_SHUTDOWN_CLEANUP | RECONCILE_INTERVAL | LOG_LEVEL | \
    TAILSCALE_OAUTH_CLIENT_ID | TAILSCALE_OAUTH_CLIENT_SECRET | TAILSCALE_API_KEY | \
    DOCKTAIL_CLOUD_KEY)
      return 0
      ;;
  esac
  return 1
}

read_config() {
  local file="$1" line key value

  while IFS= read -r line || [ -n "$line" ]; do
    # Trailing CR, so a file that has been through a Windows editor still reads.
    line="${line%$'\r'}"

    case "$line" in
      '' | '#'*) continue ;;
    esac

    if [[ ! "$line" =~ ^([A-Z][A-Z0-9_]*)=\"(.*)\"$ ]]; then
      log "Ignoring an unrecognised line in $file: only KEY=\"value\" is read."
      continue
    fi

    key="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"

    if ! config_key_is_known "$key"; then
      log "Ignoring $key in $file: not a DockTail setting."
      continue
    fi

    if ! unescape_value "$value"; then
      log "Ignoring $key in $file: the quoted value is malformed, so PHP and this reader would disagree about it."
      continue
    fi
    value="$REPLY"

    declare -g "$key=$value"
  done < "$file"
}

# The webGUI writes the two files under a lock, one rename each, so reading
# them without it can pick up the new settings with the previous credentials -
# an OAuth client ID beside the secret it replaced. The boot path is where this
# actually collides: Unraid reinstalls the plugin on every boot, and doinst.sh
# takes the same lock to convert legacy files while this script is starting.
#
# Shared, so concurrent starts do not wait on each other, and bounded: a boot
# that hangs on a lock is a worse failure than one stale reconcile cycle, and a
# writer only holds it for two file writes. Missing flock, or a wait that runs
# out, reads anyway and says so - never refuses to start.
CONFIG_LOCK="/var/run/docktail-config.lock"

# The same number Config::LOCK_WAIT uses on the PHP side, so a held lock means
# the same thing whichever side hits it.
CONFIG_LOCK_WAIT=5

load_config() {
  local file locked=0 opened=1 previous_umask

  if ! command -v flock > /dev/null 2>&1; then
    log "Reading the config without the write lock: no flock on this system. A save landing in the middle of this read could be picked up half-applied."
  else
    # Created root-only, matching the PHP side: a shared lock held by another
    # local user would push every writer out to its fails-open path. The umask
    # is restored because this one is not scoped to the brace group, and the
    # redirection is inside one because `exec` with no command would apply it
    # to this shell for good - load_config() would then be silently discarding
    # every later start and stop diagnostic.
    previous_umask=$(umask)
    umask 077
    { exec 9>> "$CONFIG_LOCK"; } 2> /dev/null
    opened=$?
    umask "$previous_umask"

    # The umask only covers creating it; an existing one from an older
    # version of this plugin is tightened here, the way the PHP side does.
    [ "$opened" -eq 0 ] && chmod 600 "$CONFIG_LOCK" 2> /dev/null

    if [ "$opened" -ne 0 ]; then
      log "Reading the config without the write lock: $CONFIG_LOCK could not be opened. A save landing in the middle of this read could be picked up half-applied."
    elif flock -s -w "$CONFIG_LOCK_WAIT" 9 2> /dev/null; then
      locked=1
    else
      log "Reading the config without the write lock: still held after ${CONFIG_LOCK_WAIT}s. A save landing now could be picked up half-applied; the Apply that caused it restarts DockTail afterwards."
    fi
  fi

  # Defaults first, user settings on top, then secrets.
  for file in "${PLUGIN_ROOT}/default.cfg" "${CONFIG_DIR}/docktail.cfg" "${CONFIG_DIR}/credentials.cfg"; do
    [ -f "$file" ] && read_config "$file"
  done

  [ "$locked" = 1 ] && flock -u 9 2> /dev/null
  { exec 9>&-; } 2> /dev/null
  return 0
}

# export_if_set NAME VALUE - skip empty values so DockTail's own defaults and
# its credential warnings behave as designed.
export_if_set() {
  [ -n "$2" ] && export "$1"="$2"
  return 0
}

is_running() {
  "$PGREP" --ns $$ --euid root -f "^${BIN}" 1> /dev/null 2> /dev/null
}

start_docktail() {
  load_config

  if [ "${ENABLE_DOCKTAIL}" != "1" ]; then
    log "DockTail is disabled in settings, not starting."
    return 0
  fi

  if [ ! -x "$BIN" ]; then
    log "Binary $BIN is missing, not starting."
    return 0
  fi

  # Normal state during the boot-time .plg re-install: the array (and Docker)
  # is not up yet. The docker_started event starts us later.
  if [ ! -S "$DOCKER_SOCK" ]; then
    log "Docker socket ${DOCKER_SOCK} is not present, not starting."
    return 0
  fi

  if [ ! -S "$TAILSCALED_SOCK" ]; then
    log "tailscaled socket ${TAILSCALED_SOCK} is not present (is the Tailscale plugin running?), not starting."
    return 0
  fi

  if is_running; then
    log "DockTail is already running."
    return 0
  fi

  # DockTail resolves the tailscale CLI from PATH; the Tailscale plugin
  # symlinks it into /usr/local/sbin.
  export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

  export_if_set RECONCILE_INTERVAL "${RECONCILE_INTERVAL}"
  export_if_set LOG_LEVEL "${LOG_LEVEL}"
  export_if_set TAILSCALE_TAILNET "${TAILSCALE_TAILNET}"
  export_if_set DEFAULT_SERVICE_TAGS "${DEFAULT_SERVICE_TAGS}"
  export_if_set IGNORE_SERVICE_NAMES "${IGNORE_SERVICE_NAMES}"
  export_if_set DELETE_UNUSED_SERVICES "${DELETE_UNUSED_SERVICES}"
  export_if_set SKIP_SHUTDOWN_CLEANUP "${SKIP_SHUTDOWN_CLEANUP}"
  export_if_set TAILSCALE_OAUTH_CLIENT_ID "${TAILSCALE_OAUTH_CLIENT_ID}"
  export_if_set TAILSCALE_OAUTH_CLIENT_SECRET "${TAILSCALE_OAUTH_CLIENT_SECRET}"
  export_if_set TAILSCALE_API_KEY "${TAILSCALE_API_KEY}"
  export_if_set DOCKTAIL_CLOUD_KEY "${DOCKTAIL_CLOUD_KEY}"

  log "Starting DockTail: $BIN"
  nohup "$BIN" >> "$LOG" 2>&1 &
  echo $! > "$PIDFILE"
  return 0
}

stop_docktail() {
  if ! is_running; then
    log "DockTail is not running."
    rm -f "$PIDFILE"
    return 0
  fi

  log "Stopping DockTail, waiting up to ${STOP_TIMEOUT}s for service cleanup."
  "$PKILL" --ns $$ --euid root -TERM -f "^${BIN}" 2> /dev/null

  local waited=0
  while [ "$waited" -lt "$STOP_TIMEOUT" ]; do
    if ! is_running; then
      log "DockTail stopped after ${waited}s."
      rm -f "$PIDFILE"
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done

  log "DockTail did not exit within ${STOP_TIMEOUT}s, sending SIGKILL (advertised services may be left behind)."
  "$PKILL" --ns $$ --euid root -KILL -f "^${BIN}" 2> /dev/null
  rm -f "$PIDFILE"
  return 0
}

restart_docktail() {
  stop_docktail
  sleep 1
  start_docktail
}

status_docktail() {
  if is_running; then
    echo "Running"
  else
    echo "Stopped"
  fi
}

case "$1" in
'start')
  start_docktail
  ;;
'stop')
  stop_docktail
  ;;
'restart')
  restart_docktail
  ;;
'status')
  status_docktail
  ;;
*)
  echo "usage $0 start|stop|restart|status"
  ;;
esac
